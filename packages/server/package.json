{
  "name": "@tv-mcp/server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that lets an AI agent drive and verify TV web apps on real devices",
  "type": "module",
  "bin": {
    "tv-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tv-mcp/protocol": "workspace:*",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
